{
  "name": "agent-saddlery-tui",
  "version": "0.0.1",
  "description": "Ink TUI for Agent Saddlery — chat interface over AG-UI protocol",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "format": "prettier --write src",
    "test": "vitest",
    "test:run": "vitest run",
    "dev": "tsc && node dist/index.js",
    "start": "node dist/index.js"
  },
  "keywords": [
    "agent",
    "tui",
    "ink",
    "react"
  ],
  "author": "Mark Mansour",
  "license": "MIT",
  "dependencies": {
    "ink": "^4.4.1",
    "keypress": "^0.2.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.33.0",
    "prettier": "^3.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.9"
  }
}
